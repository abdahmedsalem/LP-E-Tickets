<odoo>
    <record id="view_fuel_carnet_type_list" model="ir.ui.view">
        <field name="name">acpec.fuel.carnet.type.list</field>
        <field name="model">acpec.fuel.carnet.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="face_count"/>
                <field name="face_value"/>
                <field name="carnet_amount"/>
                <field name="validity_days"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_fuel_carnet_type_form" model="ir.ui.view">
        <field name="name">acpec.fuel.carnet.type.form</field>
        <field name="model">acpec.fuel.carnet.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="face_count"/>
                            <field name="face_value"/>
                            <field name="carnet_amount" readonly="1"/>
                            <field name="validity_days"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_fuel_carnet_type" model="ir.actions.act_window">
        <field name="name">Types de carnet</field>
        <field name="res_model">acpec.fuel.carnet.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_fuel_carnet_type" name="Types de carnet" parent="acpec_fueltoken_base.menu_acpec_fueltoken_config" action="action_fuel_carnet_type" sequence="10"/>
</odoo>

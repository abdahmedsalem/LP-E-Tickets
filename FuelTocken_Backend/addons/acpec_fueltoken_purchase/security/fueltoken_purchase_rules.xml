<odoo>
    <record id="rule_fuel_purchase_user_own" model="ir.rule">
        <field name="name">FuelToken achats utilisateur</field>
        <field name="model_id" ref="model_acpec_fuel_purchase"/>
        <field name="groups" eval="[(4, ref('acpec_fueltoken_base.group_fuel_user'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="rule_fuel_purchase_manager_company" model="ir.rule">
        <field name="name">FuelToken achats société</field>
        <field name="model_id" ref="model_acpec_fuel_purchase"/>
        <field name="groups" eval="[(4, ref('acpec_fueltoken_base.group_fuel_manager')), (4, ref('acpec_fueltoken_base.group_fuel_admin'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_fuel_purchase_line_user_own" model="ir.rule">
        <field name="name">FuelToken lignes achat utilisateur</field>
        <field name="model_id" ref="model_acpec_fuel_purchase_line"/>
        <field name="groups" eval="[(4, ref('acpec_fueltoken_base.group_fuel_user'))]"/>
        <field name="domain_force">[('purchase_id.partner_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="rule_fuel_purchase_line_manager_company" model="ir.rule">
        <field name="name">FuelToken lignes achat société</field>
        <field name="model_id" ref="model_acpec_fuel_purchase_line"/>
        <field name="groups" eval="[(4, ref('acpec_fueltoken_base.group_fuel_manager')), (4, ref('acpec_fueltoken_base.group_fuel_admin'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
</odoo>

<odoo>
    <record id="ir_cron_fueltoken_expiration" model="ir.cron">
        <field name="name">FuelToken - Expiration</field>
        <field name="model_id" ref="model_acpec_fuel_qr"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_expiration()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>

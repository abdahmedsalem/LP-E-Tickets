<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fuel_transaction_list_mobile_audit" model="ir.ui.view">
        <field name="name">acpec.fuel.transaction.list.mobile.audit</field>
        <field name="model">acpec.fuel.transaction</field>
        <field name="inherit_id" ref="acpec_fueltoken_core.view_fuel_transaction_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='actor_partner_id']" position="after">
                <field name="actor_user_id" optional="hide"/>
                <field name="mobile_session_id" optional="hide"/>
                <field name="device_uid" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acpec_fueltoken_mobile_phone_change_log_search" model="ir.ui.view">
        <field name="name">acpec.fueltoken.mobile.phone.change.log.search</field>
        <field name="model">acpec.fueltoken.mobile.phone.change.log</field>
        <field name="arch" type="xml">
            <search string="Historique changements téléphone">
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="old_phone"/>
                <field name="new_phone"/>
                <filter string="Sessions révoquées" name="sessions_revoked" domain="[('revoke_active_sessions', '=', True)]"/>
                <filter string="Par utilisateur" name="group_user" context="{'group_by': 'user_id'}"/>
                <filter string="Par mois" name="group_changed_at" context="{'group_by': 'changed_at:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_acpec_fueltoken_mobile_phone_change_log_list" model="ir.ui.view">
        <field name="name">acpec.fueltoken.mobile.phone.change.log.list</field>
        <field name="model">acpec.fueltoken.mobile.phone.change.log</field>
        <field name="arch" type="xml">
            <list string="Historique changements téléphone" create="0" edit="0" delete="0">
                <field name="changed_at"/>
                <field name="user_id"/>
                <field name="old_phone"/>
                <field name="new_phone"/>
                <field name="old_partner_ref"/>
                <field name="new_partner_ref"/>
                <field name="revoke_active_sessions"/>
                <field name="active_sessions_revoked_count"/>
                <field name="changed_by"/>
            </list>
        </field>
    </record>

    <record id="view_acpec_fueltoken_mobile_phone_change_log_form" model="ir.ui.view">
        <field name="name">acpec.fueltoken.mobile.phone.change.log.form</field>
        <field name="model">acpec.fueltoken.mobile.phone.change.log</field>
        <field name="arch" type="xml">
            <form string="Historique changement téléphone" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="partner_id"/>
                            <field name="changed_by"/>
                            <field name="changed_at"/>
                        </group>
                        <group>
                            <field name="old_phone"/>
                            <field name="new_phone"/>
                            <field name="old_login"/>
                            <field name="new_login"/>
                        </group>
                    </group>
                    <group>
                        <field name="old_partner_ref"/>
                        <field name="new_partner_ref"/>
                        <field name="active_sessions_revoked_count"/>
                    </group>
                    <group>
                        <field name="reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acpec_fueltoken_mobile_phone_change_log" model="ir.actions.act_window">
        <field name="name">Historique changements téléphone mobile</field>
        <field name="res_model">acpec.fueltoken.mobile.phone.change.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acpec_fueltoken_mobile_phone_change_log_search"/>
    </record>

    <menuitem id="menu_acpec_fueltoken_mobile_phone_change_log"
              name="Historique changements téléphone mobile"
              parent="acpec_fueltoken_base.menu_acpec_fueltoken_config"
              action="action_acpec_fueltoken_mobile_phone_change_log"
              sequence="56"
              groups="acpec_mobile_auth.group_mobile_auth_admin"/>

    <record id="view_acpec_fueltoken_mobile_phone_change_wizard_form" model="ir.ui.view">
        <field name="name">acpec.fueltoken.mobile.phone.change.wizard.form</field>
        <field name="model">acpec.fueltoken.mobile.phone.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Changer le téléphone mobile FuelToken">
                <group>
                    <field name="user_id"/>
                    <field name="old_phone" readonly="1"/>
                    <field name="new_phone"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Appliquer" class="btn-primary"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_acpec_fueltoken_mobile_phone_change_wizard" model="ir.actions.act_window">
        <field name="name">Changer le téléphone mobile FuelToken</field>
        <field name="res_model">acpec.fueltoken.mobile.phone.change.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="binding_view_types">form</field>
        <field name="context">{'default_user_id': active_id}</field>
    </record>
</odoo>

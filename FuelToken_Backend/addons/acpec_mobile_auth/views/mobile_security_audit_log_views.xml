<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acpec_mobile_security_audit_log_search" model="ir.ui.view">
        <field name="name">acpec.mobile.security.audit.log.search</field>
        <field name="model">acpec.mobile.security.audit.log</field>
        <field name="arch" type="xml">
            <search string="Recherche journal d’audit sécurité mobile">
                <field name="name" string="Référence"/>
                <field name="code" string="Code"/>
                <field name="operation" string="Opération"/>
                <field name="user_id" string="Utilisateur mobile"/>
                <field name="session_id" string="Session mobile"/>
                <field name="device_uid" string="Identifiant device"/>
                <field name="idempotency_key" string="Clé d’idempotence"/>

                <filter name="blocked" string="Bloqués" domain="[('blocked', '=', True)]"/>
                <filter name="success" string="Succès" domain="[('success', '=', True)]"/>
                <filter name="denied" string="Refusés" domain="[('success', '=', False)]"/>
                <filter name="invalid_code" string="Code d’action invalide" domain="[('code', '=', 'INVALID_ACTION_CODE')]"/>
                <filter name="pending_trust" string="Device en attente" domain="[('code', '=', 'DEVICE_PENDING_TRUST')]"/>

                <separator/>
                <filter name="group_code" string="Regrouper par code" context="{'group_by': 'code'}"/>
                <filter name="group_operation" string="Regrouper par opération" context="{'group_by': 'operation'}"/>
                <filter name="group_user" string="Regrouper par utilisateur" context="{'group_by': 'user_id'}"/>
                <filter name="group_session" string="Regrouper par session" context="{'group_by': 'session_id'}"/>
                <filter name="group_create_date" string="Regrouper par date" context="{'group_by': 'create_date:day'}"/>
            </search>
        </field>
    </record>

    <record id="view_acpec_mobile_security_audit_log_tree" model="ir.ui.view">
        <field name="name">acpec.mobile.security.audit.log.list</field>
        <field name="model">acpec.mobile.security.audit.log</field>
        <field name="arch" type="xml">
            <list string="Journal d’audit sécurité mobile" create="0" edit="0" delete="0">
                <field name="create_date" string="Date"/>
                <field name="name"/>
                <field name="event_type"/>
                <field name="severity"/>
                <field name="code"/>
                <field name="operation"/>
                <field name="user_id"/>
                <field name="session_id"/>
                <field name="device_uid"/>
                <field name="device_trust_state"/>
                <field name="success"/>
                <field name="blocked"/>
                <field name="failed_count_before"/>
                <field name="failed_count_after"/>
            </list>
        </field>
    </record>

    <record id="view_acpec_mobile_security_audit_log_form" model="ir.ui.view">
        <field name="name">acpec.mobile.security.audit.log.form</field>
        <field name="model">acpec.mobile.security.audit.log</field>
        <field name="arch" type="xml">
            <form string="Journal d’audit sécurité mobile" create="0" edit="0" delete="0">
                <sheet>
                    <group string="Événement">
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="event_type" readonly="1"/>
                            <field name="severity" readonly="1"/>
                            <field name="code" readonly="1"/>
                            <field name="operation" readonly="1"/>
                            <field name="endpoint" readonly="1"/>
                            <field name="idempotency_key" readonly="1"/>
                        </group>
                        <group>
                            <field name="success" readonly="1"/>
                            <field name="blocked" readonly="1"/>
                            <field name="action_code_present" readonly="1"/>
                            <field name="action_code_format_valid" readonly="1"/>
                            <field name="failed_count_before" readonly="1"/>
                            <field name="failed_count_after" readonly="1"/>
                        </group>
                    </group>

                    <group string="Contexte mobile">
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="session_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="device_uid" readonly="1"/>
                            <field name="device_name" readonly="1"/>
                            <field name="device_trust_state" readonly="1"/>
                            <field name="ip_address" readonly="1"/>
                        </group>
                    </group>

                    <group string="Messages">
                        <field name="public_message" readonly="1"/>
                        <field name="debug_reason" readonly="1"/>
                    </group>

                    <group string="Technique">
                        <field name="user_agent" readonly="1"/>
                        <field name="target_model" readonly="1"/>
                        <field name="target_res_id" readonly="1"/>
                        <field name="business_ref" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acpec_mobile_security_audit_log" model="ir.actions.act_window">
        <field name="name">Journal d’audit sécurité mobile</field>
        <field name="res_model">acpec.mobile.security.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acpec_mobile_security_audit_log_search"/>
    </record>
</odoo>

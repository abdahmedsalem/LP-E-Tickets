<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acpec_mobile_auth_account_request_tree" model="ir.ui.view">
        <field name="name">acpec.mobile.auth.account.request.list</field>
        <field name="model">acpec.mobile.auth.account.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="name_display"/>
                <field name="signup_identifier"/>
                <field name="signup_identifier_type"/>
                <field name="company_id"/>
                <field name="state"/>
                <field name="requested_at"/>
                <field name="reviewed_at"/>
            </list>
        </field>
    </record>

    <record id="view_acpec_mobile_auth_account_request_form" model="ir.ui.view">
        <field name="name">acpec.mobile.auth.account.request.form</field>
        <field name="model">acpec.mobile.auth.account.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" invisible="state != 'pending'" class="oe_highlight"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="name_display"/>
                            <field name="signup_identifier"/>
                            <field name="signup_identifier_type"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="login"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="requested_at" readonly="1"/>
                            <field name="reviewed_at" readonly="1"/>
                            <field name="reviewed_by" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                        <field name="rejection_reason" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_acpec_mobile_app_version_policy_tree" model="ir.ui.view">
        <field name="name">acpec.mobile.app.version.policy.list</field>
        <field name="model">acpec.mobile.app.version.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="platform"/>
                <field name="min_supported_version"/>
                <field name="latest_version"/>
                <field name="force_update"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_acpec_mobile_app_version_policy_form" model="ir.ui.view">
        <field name="name">acpec.mobile.app.version.policy.form</field>
        <field name="model">acpec.mobile.app.version.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="platform"/>
                            <field name="active"/>
                            <field name="force_update"/>
                        </group>
                        <group>
                            <field name="min_supported_version"/>
                            <field name="latest_version"/>
                            <field name="min_supported_build"/>
                            <field name="latest_build"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acpec_mobile_auth_account_request" model="ir.actions.act_window">
        <field name="name">Account Requests</field>
        <field name="res_model">acpec.mobile.auth.account.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_acpec_mobile_app_version_policy" model="ir.actions.act_window">
        <field name="name">App Version Policies</field>
        <field name="res_model">acpec.mobile.app.version.policy</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="view_acpec_mobile_device_tree" model="ir.ui.view">
        <field name="name">acpec.mobile.device.list</field>
        <field name="model">acpec.mobile.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="company_id"/>
                <field name="stable_device_uid"/>
                <field name="device_name"/>
                <field name="platform"/>
                <field name="app_version"/>
                <field name="trust_state"/>
                <field name="first_seen_at"/>
                <field name="last_seen_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_acpec_mobile_device_form" model="ir.ui.view">
        <field name="name">acpec.mobile.device.form</field>
        <field name="model">acpec.mobile.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_trust_device" type="object" string="Trust Device"
                            invisible="trust_state == 'trusted'"
                            class="btn-primary"
                            groups="acpec_mobile_auth.group_mobile_auth_admin"/>
                    <button name="action_block_device" type="object" string="Block Device"
                            invisible="trust_state == 'blocked'"
                            class="btn-secondary"
                            groups="acpec_mobile_auth.group_mobile_auth_admin"/>
                    <button name="action_reset_device_trust" type="object" string="Reset Trust"
                            invisible="trust_state == 'pending_trust'"
                            class="btn-secondary"
                            groups="acpec_mobile_auth.group_mobile_auth_admin"/>
                    <field name="trust_state" widget="statusbar" statusbar_visible="pending_trust,trusted,blocked"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="user_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="stable_device_uid"/>
                            <field name="device_name"/>
                            <field name="platform"/>
                            <field name="app_version"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="first_seen_at" readonly="1"/>
                            <field name="last_seen_at" readonly="1"/>
                            <field name="trusted_at" readonly="1"/>
                            <field name="trusted_by" readonly="1"/>
                        </group>
                        <group>
                            <field name="blocked_at" readonly="1"/>
                            <field name="blocked_by" readonly="1"/>
                            <field name="blocked_reason"/>
                            <field name="trust_note"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_acpec_mobile_device_search" model="ir.ui.view">
        <field name="name">acpec.mobile.device.search</field>
        <field name="model">acpec.mobile.device</field>
        <field name="arch" type="xml">
            <search string="Recherche devices mobiles">
                <field name="name" string="Device"/>
                <field name="user_id" string="Utilisateur"/>
                <field name="partner_id" string="Contact"/>
                <field name="stable_device_uid" string="Identifiant device stable"/>
                <field name="device_name" string="Nom device"/>
                <filter name="pending_trust" string="Devices en attente" domain="[('trust_state', '=', 'pending_trust')]"/>
                <filter name="trusted" string="Devices approuvés" domain="[('trust_state', '=', 'trusted')]"/>
                <filter name="blocked" string="Devices bloqués" domain="[('trust_state', '=', 'blocked')]"/>
                <filter name="active" string="Actifs" domain="[('active', '=', True)]"/>
                <separator/>
                <filter name="group_by_user" string="Regrouper par utilisateur" context="{'group_by': 'user_id'}"/>
                <filter name="group_by_trust_state" string="Regrouper par état device" context="{'group_by': 'trust_state'}"/>
                <filter name="group_by_platform" string="Regrouper par plateforme" context="{'group_by': 'platform'}"/>
            </search>
        </field>
    </record>

    <record id="action_acpec_mobile_device" model="ir.actions.act_window">
        <field name="name">Devices mobiles</field>
        <field name="res_model">acpec.mobile.device</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acpec_mobile_device_search"/>
    </record>

    <record id="view_acpec_mobile_session_tree" model="ir.ui.view">
        <field name="name">acpec.mobile.session.list</field>
        <field name="model">acpec.mobile.session</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="mobile_user_label"/>
                <field name="mobile_phone"/>
                <field name="partner_id"/>
                <field name="company_id"/>
                <field name="device_uid"/>
                <field name="device_id"/>
                <field name="device_name"/>
                <field name="platform"/>
                <field name="device_trust_state"/>
                <field name="expires_at"/>
                <field name="refresh_expires_at"/>
                <field name="last_seen_at"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_acpec_mobile_session_form" model="ir.ui.view">
        <field name="name">acpec.mobile.session.form</field>
        <field name="model">acpec.mobile.session</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_trust_device" type="object" string="Trust Device"
                            invisible="not device_uid or device_trust_state == 'trusted'"
                            class="btn-primary"
                            groups="acpec_mobile_auth.group_mobile_auth_admin"/>
                    <button name="action_block_device" type="object" string="Block Device"
                            invisible="device_trust_state == 'blocked'"
                            class="btn-secondary"
                            groups="acpec_mobile_auth.group_mobile_auth_admin"/>
                    <button name="action_reset_device_trust" type="object" string="Reset Trust"
                            invisible="device_trust_state == 'pending_trust'"
                            class="btn-secondary"
                            groups="acpec_mobile_auth.group_mobile_auth_admin"/>
                    <button name="action_revoke" type="object" string="Revoke"
                            invisible="state != 'active'"
                            class="btn-secondary"
                            groups="acpec_mobile_auth.group_mobile_auth_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,rotated,expired,revoked"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="mobile_user_label" readonly="1"/>
                            <field name="mobile_phone" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="device_uid" readonly="1"/>
                            <field name="device_id" readonly="1"/>
                            <field name="device_name" readonly="1"/>
                            <field name="platform" readonly="1"/>
                            <field name="app_version" readonly="1"/>
                            <field name="device_trust_state" readonly="1"/>
                            <field name="device_trusted_at" readonly="1"/>
                            <field name="device_blocked_at" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="expires_at" readonly="1"/>
                            <field name="refresh_expires_at" readonly="1"/>
                            <field name="last_seen_at" readonly="1"/>
                            <field name="revoked_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="ip_address" readonly="1"/>
                            <field name="user_agent" readonly="1"/>
                            <field name="device_trust_note"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_acpec_mobile_session_search" model="ir.ui.view">
        <field name="name">acpec.mobile.session.search</field>
        <field name="model">acpec.mobile.session</field>
        <field name="arch" type="xml">
            <search string="Recherche sessions mobile">
                <field name="name" string="Session"/>
                <field name="user_id" string="Utilisateur"/>
                <field name="mobile_user_label" string="Utilisateur mobile"/>
                <field name="mobile_phone" string="Téléphone mobile"/>
                <field name="partner_id" string="Contact"/>
                <field name="device_uid" string="Identifiant device"/>
                <field name="device_id" string="Device durable"/>
                <field name="device_name" string="Nom device"/>

                <filter name="approval_candidate" string="Candidats approbation" domain="[('is_device_approval_candidate', '=', True)]"/>
                <filter name="pending_trust" string="Devices en attente" domain="[('device_trust_state', '=', 'pending_trust')]"/>
                <filter name="trusted" string="Devices approuvés" domain="[('device_trust_state', '=', 'trusted')]"/>
                <filter name="blocked" string="Devices bloqués" domain="[('device_trust_state', '=', 'blocked')]"/>
                <filter name="active" string="Sessions actives" domain="[('state', '=', 'active')]"/>

                <separator/>
                <filter name="group_by_user" string="Regrouper par utilisateur" context="{'group_by': 'user_id'}"/>
                <filter name="group_by_mobile_user_label" string="Regrouper par utilisateur mobile" context="{'group_by': 'mobile_user_label'}"/>
                <filter name="group_by_device_uid" string="Regrouper par device UID" context="{'group_by': 'device_uid'}"/>
                <filter name="group_by_device_id" string="Regrouper par device durable" context="{'group_by': 'device_id'}"/>
                <filter name="group_by_trust_state" string="Regrouper par état device" context="{'group_by': 'device_trust_state'}"/>
            </search>
        </field>
    </record>

    <record id="action_acpec_mobile_session" model="ir.actions.act_window">
        <field name="name">Sessions mobile</field>
        <field name="res_model">acpec.mobile.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acpec_mobile_session_search"/>
    </record>


    <record id="view_res_users_search_mobile_auth" model="ir.ui.view">
        <field name="name">res.users.search.mobile.auth</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Utilisateurs mobiles" name="acpec_mobile_only_users" domain="[('mobile_only', '=', True)]"/>
                <filter string="Utilisateurs non mobiles" name="acpec_non_mobile_users" domain="[('mobile_only', '=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_search_mobile_auth" model="ir.ui.view">
        <field name="name">res.partner.search.mobile.auth</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Partenaires mobiles" name="acpec_mobile_partners" domain="[('acpec_is_mobile_partner', '=', True)]"/>
                <filter string="Partenaires non mobiles" name="acpec_non_mobile_partners" domain="[('acpec_is_mobile_partner', '=', False)]"/>
            </xpath>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acpec_mobile_api_error_marker_search" model="ir.ui.view">
        <field name="name">acpec.mobile.api.error.marker.search</field>
        <field name="model">acpec.mobile.api.error.marker</field>
        <field name="arch" type="xml">
            <search string="Recherche incidents API mobile">
                <field name="name" string="Référence"/>
                <field name="last_seen_reference" string="Dernière référence"/>
                <field name="endpoint" string="Point d’accès"/>
                <field name="operation" string="Opération"/>
                <field name="exception_type" string="Type d’exception"/>
                <field name="fingerprint" string="Empreinte"/>

                <filter name="state_new" string="Nouveaux" domain="[('state', '=', 'new')]"/>
                <filter name="state_reviewed" string="Vus" domain="[('state', '=', 'reviewed')]"/>
                <filter name="state_resolved" string="Résolus" domain="[('state', '=', 'resolved')]"/>
                <filter name="state_ignored" string="Ignorés" domain="[('state', '=', 'ignored')]"/>

                <separator/>
                <filter name="group_state" string="Regrouper par état" context="{'group_by': 'state'}"/>
                <filter name="group_endpoint" string="Regrouper par point d’accès" context="{'group_by': 'endpoint'}"/>
                <filter name="group_exception_type" string="Regrouper par type d’exception" context="{'group_by': 'exception_type'}"/>
                <filter name="group_last_seen_date" string="Regrouper par dernière apparition" context="{'group_by': 'last_seen_date:day'}"/>
            </search>
        </field>
    </record>

    <record id="view_acpec_mobile_api_error_marker_list" model="ir.ui.view">
        <field name="name">acpec.mobile.api.error.marker.list</field>
        <field name="model">acpec.mobile.api.error.marker</field>
        <field name="arch" type="xml">
            <list string="Incidents API mobile" create="0" edit="0" delete="0">
                <field name="state"/>
                <field name="last_seen_date" string="Dernière apparition"/>
                <field name="occurrence_count" string="Occurrences"/>
                <field name="last_seen_reference" string="Dernière référence"/>
                <field name="endpoint"/>
                <field name="operation"/>
                <field name="exception_type"/>
                <field name="exception_summary"/>
            </list>
        </field>
    </record>

    <record id="view_acpec_mobile_api_error_marker_form" model="ir.ui.view">
        <field name="name">acpec.mobile.api.error.marker.form</field>
        <field name="model">acpec.mobile.api.error.marker</field>
        <field name="arch" type="xml">
            <form string="Incident API mobile" create="0" delete="0">
                <sheet>
                    <group string="Suivi">
                        <group>
                            <field name="state"/>
                            <field name="occurrence_count" readonly="1"/>
                            <field name="first_seen_date" readonly="1"/>
                            <field name="last_seen_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="first_seen_reference" readonly="1"/>
                            <field name="last_seen_reference" readonly="1"/>
                            <field name="reviewed_by_id" readonly="1"/>
                            <field name="reviewed_date" readonly="1"/>
                        </group>
                    </group>

                    <group string="Incident">
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="code" readonly="1"/>
                            <field name="fingerprint" readonly="1"/>
                            <field name="exception_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="endpoint" readonly="1"/>
                            <field name="operation" readonly="1"/>
                            <field name="last_user_id" readonly="1"/>
                            <field name="last_company_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="Résumé">
                        <field name="exception_summary" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Résolution">
                        <field name="resolution_note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acpec_mobile_api_error_marker" model="ir.actions.act_window">
        <field name="name">Incidents API mobile</field>
        <field name="res_model">acpec.mobile.api.error.marker</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acpec_mobile_api_error_marker_search"/>
        <field name="context">{'search_default_state_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun incident API mobile.
            </p>
            <p>
                Les incidents techniques retournés à Flutter sont agrégés ici sans traceback ni payload sensible.
                Utilisez la dernière référence pour rechercher le traceback dans les logs serveur Odoo.
            </p>
        </field>
    </record>

    <menuitem id="menu_mobile_api_error_markers"
              name="Incidents API mobile"
              parent="acpec_mobile_auth.menu_mobile_auth_operations"
              action="action_acpec_mobile_api_error_marker"
              sequence="85"
              groups="acpec_mobile_auth.group_mobile_security_auditor"/>
</odoo>

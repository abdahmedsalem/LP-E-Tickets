<odoo>
    <record id="module_category_acpec_fueltoken" model="ir.module.category">
        <field name="name">ACPEC Tickets Carburant</field>
        <field name="sequence">40</field>
    </record>

    <record id="privilege_acpec_fueltoken" model="res.groups.privilege">
        <field name="name">ACPEC Tickets Carburant</field>
        <field name="category_id" ref="module_category_acpec_fueltoken"/>
        <field name="sequence">40</field>
    </record>

    <record id="group_fuel_user" model="res.groups">
        <field name="name">Tickets Carburant - Client</field>
        <field name="privilege_id" ref="privilege_acpec_fueltoken"/>
    </record>

    <record id="group_fuel_station" model="res.groups">
        <field name="name">Tickets Carburant - Station</field>
        <field name="privilege_id" ref="privilege_acpec_fueltoken"/>
    </record>

    <record id="group_fuel_manager" model="res.groups">
        <field name="name">Tickets Carburant - Gestionnaire</field>
        <field name="privilege_id" ref="privilege_acpec_fueltoken"/>
        <field name="implied_ids" eval="[(4, ref('group_fuel_user'))]"/>
    </record>

    <record id="group_fuel_admin" model="res.groups">
        <field name="name">Tickets Carburant - Administrateur</field>
        <field name="privilege_id" ref="privilege_acpec_fueltoken"/>
        <field name="implied_ids" eval="[(3, ref('group_fuel_manager'))]"/>
    </record>
</odoo>

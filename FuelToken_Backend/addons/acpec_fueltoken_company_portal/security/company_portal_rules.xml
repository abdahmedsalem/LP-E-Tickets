<odoo>
    <!--
        Odoo portal pages are model-backed: portal users receive read ACLs and
        record rules limited to their own commercial partner.  FuelToken Société
        follows the same principle: being a classic portal user is not enough;
        access is limited to records attached to the user's commercial partner,
        while the controller also requires an active acpec.fuel.distributor.
    -->

    <record id="rule_res_partner_fueltoken_company_portal" model="ir.rule">
        <field name="name">FuelToken portail société - partenaires lisibles</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('id', 'child_of', [(user.partner_id.commercial_partner_id.id or user.partner_id.id)])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_fuel_distributor_company_portal" model="ir.rule">
        <field name="name">FuelToken portail société - compte société actif</field>
        <field name="model_id" ref="acpec_fueltoken_company.model_acpec_fuel_distributor"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', '=', (user.partner_id.commercial_partner_id.id or user.partner_id.id)), ('active', '=', True), ('state', '=', 'active')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_fuel_wallet_company_portal" model="ir.rule">
        <field name="name">FuelToken portail société - wallet société</field>
        <field name="model_id" ref="acpec_fueltoken_core.model_acpec_fuel_wallet"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', '=', (user.partner_id.commercial_partner_id.id or user.partner_id.id))]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>


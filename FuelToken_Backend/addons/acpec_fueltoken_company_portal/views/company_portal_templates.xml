<odoo>
    <template id="portal_my_home_fueltoken" name="Tickets Carburant - Home Portal Entry" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="after">
            <!--
                Carte statique volontairement placée hors du conteneur o_portal_docs.
                Elle ne participe pas au mécanisme async des compteurs portail Odoo,
                ce qui évite le spinner résiduel observé sur /my.
            -->
            <div class="row mt-3 o_acpec_fueltoken_portal_home_entry">
                <div class="col-12 col-md-6">
                    <a href="/my/fueltoken"
                       class="d-flex align-items-center p-3 gap-3 h-100 rounded text-decoration-none text-reset bg-100">
                        <img src="/acpec_fueltoken_base/static/description/icon.png"
                             alt="Tickets Carburant"
                             class="flex-shrink-0"
                             style="width: 56px; height: 56px; object-fit: contain;"/>
                        <div class="min-w-0">
                            <h5 class="mb-1">Tickets Carburant</h5>
                            <p class="mb-0 text-muted">Acheter et suivre vos carnets de tickets</p>
                        </div>
                    </a>
                </div>
            </div>
        </xpath>
    </template>

    <template id="portal_fueltoken_company_dashboard" name="Tickets Carburant Société - Portail">
        <t t-call="portal.portal_layout">
            <div class="container my-4 o_acpec_fueltoken_company_portal">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <img src="/acpec_fueltoken_base/static/description/icon.png" alt="Tickets Carburant" style="width: 40px; height: 40px; object-fit: contain;"/>
                            <h2 class="mb-0">Tickets Carburant</h2>
                        </div>
                        <p class="text-muted mb-0">
                            <span t-if="distributor" t-esc="distributor.display_name"/>
                            <span t-else="" t-esc="commercial_partner.display_name"/>
                        </p>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/my/fueltoken/purchases/new" class="btn btn-primary">Nouvelle demande d’achat</a>
                        <a href="/my" class="btn btn-outline-secondary">Retour au portail</a>
                    </div>
                </div>

                <div t-if="distributor" class="alert alert-info" role="alert">
                    Les demandes d’achat créées depuis le portail sont soumises à validation par
                    <span t-esc="portal_company_name"/> avant crédit du wallet société.
                </div>
                <div t-else="" class="alert alert-warning" role="alert">
                    Vous pouvez soumettre une demande d’achat Tickets Carburant. La gestion des membres et la distribution de carnets seront disponibles après activation du compte société par
                    <span t-esc="portal_company_name"/>.
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="text-muted small">Tickets disponibles</div>
                                <div class="fs-4 fw-bold" t-esc="total_tickets_available"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="text-muted small">Carnets distribuables</div>
                                <div class="fs-4 fw-bold" t-esc="total_transferable_carnets"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="text-muted small">Montant disponible</div>
                                <div class="fs-4 fw-bold">
                                    <span t-esc="total_amount_available"/>
                                    <span t-esc="portal_company.currency_id.name"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="text-muted small">Membres</div>
                                <div class="fs-4 fw-bold" t-esc="member_count"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="card mb-4" t-if="distributor">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span>Carnets disponibles</span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Type de carnet</th>
                                            <th class="text-end">Tickets</th>
                                            <th class="text-end">Carnets distribuables</th>
                                            <th class="text-end">Montant</th>
                                            <th>Expiration</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="ticket_rows" t-as="row">
                                            <td><span t-esc="row['line'].carnet_type_id.display_name"/></td>
                                            <td class="text-end"><span t-esc="row['line'].qty_available"/></td>
                                            <td class="text-end"><span t-esc="row['transferable_carnet_count']"/></td>
                                            <td class="text-end">
                                                <span t-esc="row['line'].amount_available"/>
                                                <span t-esc="row['line'].currency_id.name"/>
                                            </td>
                                            <td>
                                                <span t-if="row['line'].expires_at" t-field="row['line'].expires_at"/>
                                                <span t-else="">—</span>
                                            </td>
                                        </tr>
                                        <tr t-if="not ticket_rows">
                                            <td colspan="5" class="text-muted text-center py-3">Aucun ticket disponible.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="card mb-4">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span>Dernières demandes d’achat</span>
                                <a href="/my/fueltoken/purchases" class="btn btn-sm btn-link">Tout voir</a>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Référence</th>
                                            <th>État</th>
                                            <th class="text-end">Tickets</th>
                                            <th class="text-end">Montant</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="purchases" t-as="purchase">
                                            <td>
                                                <a t-att-href="'/my/fueltoken/purchases/%s' % purchase.id" t-esc="purchase.name"/>
                                            </td>
                                            <td><span t-field="purchase.state"/></td>
                                            <td class="text-end"><span t-esc="purchase.face_qty_total"/></td>
                                            <td class="text-end">
                                                <span t-esc="purchase.amount_total"/>
                                                <span t-esc="purchase.currency_id.name"/>
                                            </td>
                                        </tr>
                                        <tr t-if="not purchases">
                                            <td colspan="4" class="text-muted text-center py-3">Aucune demande d’achat.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="card mb-4" t-if="distributor">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span>Dernières distributions</span>
                                <div class="d-flex gap-2">
                                    <a href="/my/fueltoken/distributions/new" class="btn btn-sm btn-outline-primary">Distribuer</a>
                                    <a href="/my/fueltoken/distributions" class="btn btn-sm btn-link">Tout voir</a>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Référence</th>
                                            <th>Bénéficiaire</th>
                                            <th class="text-end">Montant</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="distributions" t-as="transfer">
                                            <td>
                                                <a t-att-href="'/my/fueltoken/distributions/%s' % transfer.id" t-esc="transfer.name"/>
                                            </td>
                                            <td><span t-esc="transfer.dest_partner_id.display_name"/></td>
                                            <td class="text-end">
                                                <span t-esc="transfer.amount_total"/>
                                                <span t-esc="transfer.currency_id.name"/>
                                            </td>
                                        </tr>
                                        <tr t-if="not distributions">
                                            <td colspan="3" class="text-muted text-center py-3">Aucune distribution.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="card mb-4" t-if="distributor">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span>Membres</span>
                                <a href="/my/fueltoken/members" class="btn btn-sm btn-link">Gérer</a>
                            </div>
                            <div class="list-group list-group-flush">
                                <div class="list-group-item d-flex justify-content-between align-items-start" t-foreach="member_rows" t-as="row">
                                    <div>
                                        <div class="fw-semibold" t-esc="row['name']"/>
                                        <div class="text-muted small">
                                            <span t-esc="row['phone']"/>
                                            <span t-if="row['email']"> · <span t-esc="row['email']"/></span>
                                        </div>
                                    </div>
                                    <span t-if="row['mobile_ready']" class="badge text-bg-success">Mobile actif</span>
                                    <span t-else="" class="badge text-bg-secondary">Non prêt</span>
                                </div>
                                <div class="list-group-item text-muted text-center" t-if="not member_rows">
                                    Aucun membre rattaché.
                                </div>
                            </div>
                        </div>

                        <div class="card mb-4" t-if="not distributor">
                            <div class="card-header">Compte société Tickets Carburant</div>
                            <div class="card-body text-muted">
                                Aucun compte société Tickets Carburant actif n’est encore rattaché à ce portail. Les demandes d’achat restent possibles ; la distribution à des membres sera ouverte après activation.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_fueltoken_company_purchases" name="Tickets Carburant Société - Achats">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2>Demandes d’achat Tickets Carburant</h2>
                    <div class="d-flex gap-2">
                        <a href="/my/fueltoken/purchases/new" class="btn btn-primary">Nouvelle demande</a>
                        <a href="/my/fueltoken" class="btn btn-outline-secondary">Retour Tickets Carburant</a>
                    </div>
                </div>
                <div class="table-responsive card">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Référence</th>
                                <th>État</th>
                                <th>Date</th>
                                <th class="text-end">Tickets</th>
                                <th class="text-end">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="purchases" t-as="purchase">
                                <td><a t-att-href="'/my/fueltoken/purchases/%s' % purchase.id" t-esc="purchase.name"/></td>
                                <td><span t-field="purchase.state"/></td>
                                <td>
                                    <span t-if="purchase.submitted_at" t-field="purchase.submitted_at"/>
                                    <span t-else="" t-field="purchase.create_date"/>
                                </td>
                                <td class="text-end"><span t-esc="purchase.face_qty_total"/></td>
                                <td class="text-end"><span t-esc="purchase.amount_total"/> <span t-esc="purchase.currency_id.name"/></td>
                            </tr>
                            <tr t-if="not purchases">
                                <td colspan="5" class="text-muted text-center py-4">Aucune demande d’achat Tickets Carburant.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_fueltoken_company_purchase_detail" name="Tickets Carburant Société - Détail achat">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="mb-1">Demande d’achat <span t-esc="purchase.name"/></h2>
                        <div class="text-muted">État : <span t-field="purchase.state"/></div>
                    </div>
                    <a href="/my/fueltoken/purchases" class="btn btn-outline-secondary">Retour achats</a>
                </div>
                <div t-if="created" class="alert alert-success" role="alert">
                    Votre demande d’achat a été soumise. Elle sera traitée par <span t-esc="portal_company_name"/>.
                </div>
                <div class="card mb-4">
                    <div class="card-body row g-3">
                        <div class="col-md-4"><strong>Montant total</strong><br/><span t-esc="purchase.amount_total"/> <span t-esc="purchase.currency_id.name"/></div>
                        <div class="col-md-4"><strong>Tickets</strong><br/><span t-esc="purchase.face_qty_total"/></div>
                        <div class="col-md-4"><strong>Référence paiement</strong><br/><span t-esc="purchase.payment_reference or '—'"/></div>
                    </div>
                </div>
                <div class="table-responsive card">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Type de carnet</th>
                                <th class="text-end">Carnets</th>
                                <th class="text-end">Tickets</th>
                                <th class="text-end">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="purchase.line_ids" t-as="line">
                                <td><span t-esc="line.carnet_type_id.display_name"/></td>
                                <td class="text-end"><span t-esc="line.carnet_qty"/></td>
                                <td class="text-end"><span t-esc="line.generated_face_qty"/></td>
                                <td class="text-end"><span t-esc="line.amount_total"/> <span t-esc="line.currency_id.name"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_fueltoken_company_purchase_new" name="Tickets Carburant Société - Nouvelle demande d'achat">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="mb-1">Nouvelle demande d’achat Tickets Carburant</h2>
                        <div class="text-muted" t-esc="commercial_partner.display_name"/>
                    </div>
                    <a href="/my/fueltoken/purchases" class="btn btn-outline-secondary">Retour achats</a>
                </div>

                <div class="alert alert-danger" role="alert" t-if="error">
                    <span t-esc="error"/>
                </div>

                <form action="/my/fueltoken/purchases/new" method="post" enctype="multipart/form-data" class="card">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="idempotency_key" t-att-value="idempotency_key"/>

                    <div class="card-body">
                        <div class="alert alert-info" role="alert">
                            Saisissez le nombre de carnets souhaité par type. La demande sera soumise à validation par
                            <span t-esc="portal_company_name"/>.
                        </div>

                        <div class="table-responsive mb-4">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Type de carnet</th>
                                        <th class="text-end">Tickets / carnet</th>
                                        <th class="text-end">Valeur ticket</th>
                                        <th class="text-end">Montant carnet</th>
                                        <th style="width: 180px;" class="text-end">Carnets à acheter</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="carnet_rows" t-as="row">
                                        <td><span t-esc="row['carnet_type'].display_name"/></td>
                                        <td class="text-end"><span t-esc="row['carnet_type'].face_count"/></td>
                                        <td class="text-end">
                                            <span t-esc="row['carnet_type'].face_value"/>
                                            <span t-esc="row['carnet_type'].currency_id.name"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="row['carnet_type'].carnet_amount"/>
                                            <span t-esc="row['carnet_type'].currency_id.name"/>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   min="0"
                                                   step="1"
                                                   class="form-control text-end"
                                                   t-att-name="'qty_%s' % row['carnet_type'].id"
                                                   t-att-value="row['qty']"
                                                   placeholder="0"/>
                                        </td>
                                    </tr>
                                    <tr t-if="not carnet_rows">
                                        <td colspan="5" class="text-muted text-center py-4">Aucun type de carnet actif disponible.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="payment_reference">Référence paiement</label>
                                <input id="payment_reference"
                                       name="payment_reference"
                                       type="text"
                                       class="form-control"
                                       t-att-value="payment_reference"
                                       placeholder="Référence virement, reçu, transaction..."/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="proof_file">Preuve de paiement <span class="text-danger">*</span></label>
                                <input id="proof_file"
                                       name="proof_file"
                                       type="file"
                                       class="form-control"
                                       required="required"/>
                                <div class="form-text">Joignez la preuve exigée pour soumettre la demande.</div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer d-flex justify-content-end gap-2">
                        <a href="/my/fueltoken/purchases" class="btn btn-outline-secondary">Annuler</a>
                        <button type="submit" class="btn btn-primary" t-att-disabled="not carnet_rows and 'disabled' or None">
                            Soumettre la demande
                        </button>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="portal_fueltoken_company_members" name="Tickets Carburant Société - Membres">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
                    <div>
                        <h2 class="mb-1">Membres autorisés</h2>
                        <div class="text-muted">
                            <span t-esc="distributor.display_name"/>
                        </div>
                    </div>
                    <a href="/my/fueltoken" class="btn btn-outline-secondary">Retour Tickets Carburant</a>
                </div>

                <div class="alert alert-info" role="alert">
                    Ajoutez uniquement des membres dont vous connaissez le numéro exact. La recherche ne propose aucune liste publique : le membre doit déjà avoir un compte mobile Tickets Carburant actif et approuvé.
                </div>
                <div t-if="success" class="alert alert-success" role="alert" t-esc="success"/>
                <div t-if="error" class="alert alert-danger" role="alert" t-esc="error"/>

                <div class="row g-4">
                    <div class="col-lg-5">
                        <form action="/my/fueltoken/members/add" method="post" class="card">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="card-header">Ajouter un membre par téléphone</div>
                            <div class="card-body">
                                <label class="form-label" for="member_phone">Téléphone mobile du membre</label>
                                <input id="member_phone"
                                       name="phone"
                                       type="tel"
                                       autocomplete="off"
                                       class="form-control"
                                       t-att-value="phone"
                                       placeholder="Ex. 46000099"
                                       required="required"/>
                                <div class="form-text">
                                    Recherche exacte uniquement. Le nom du membre est affiché seulement si ce numéro correspond à un compte mobile prêt.
                                </div>
                            </div>
                            <div class="card-footer text-end">
                                <button type="submit" class="btn btn-primary">Ajouter le membre</button>
                            </div>
                        </form>
                    </div>

                    <div class="col-lg-7">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span>Liste des membres</span>
                                <span class="badge text-bg-secondary" t-esc="member_count"/>
                            </div>
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Membre</th>
                                            <th>Téléphone</th>
                                            <th>État mobile</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="member_rows" t-as="row">
                                            <td>
                                                <div class="fw-semibold" t-esc="row['name']"/>
                                                <div class="text-muted small" t-if="row['email']" t-esc="row['email']"/>
                                            </td>
                                            <td><span t-esc="row['phone'] or row['mobile_login'] or '—'"/></td>
                                            <td>
                                                <span t-if="row['mobile_ready']" class="badge text-bg-success">Mobile actif</span>
                                                <span t-else="" class="badge text-bg-secondary">Non prêt</span>
                                            </td>
                                            <td class="text-end">
                                                <form action="/my/fueltoken/members/remove" method="post" class="d-inline">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <input type="hidden" name="member_id" t-att-value="row['partner'].id"/>
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Retirer ce membre du compte société ?');">
                                                        Retirer
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                        <tr t-if="not member_rows">
                                            <td colspan="4" class="text-muted text-center py-4">Aucun membre rattaché.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_fueltoken_company_distribution_new" name="Tickets Carburant Société - Nouvelle distribution">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="mb-1">Distribuer des carnets</h2>
                        <div class="text-muted" t-esc="distributor.display_name"/>
                    </div>
                    <a href="/my/fueltoken/distributions" class="btn btn-outline-secondary">Retour distributions</a>
                </div>

                <div class="alert alert-info" role="alert">
                    Sélectionnez un membre autorisé puis les carnets à distribuer. La distribution est confirmée immédiatement et crédite le wallet mobile du membre.
                </div>
                <div t-if="error" class="alert alert-danger" role="alert" t-esc="error"/>

                <form action="/my/fueltoken/distributions/new" method="post" class="card">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="idempotency_key" t-att-value="idempotency_key"/>

                    <div class="card-body">
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label" for="member_partner_id">Bénéficiaire</label>
                                <select name="member_partner_id" id="member_partner_id" class="form-select" required="required">
                                    <option value="">Sélectionner un membre mobile actif...</option>
                                    <option t-foreach="member_rows" t-as="row"
                                            t-att-value="row['partner'].id"
                                            t-att-selected="row['partner'].id == member_partner_id and 'selected' or None">
                                        <t t-esc="row['name']"/>
                                        <t t-if="row['phone']"> - <t t-esc="row['phone']"/></t>
                                    </option>
                                </select>
                                <div class="form-text">
                                    Seuls les membres autorisés avec compte mobile actif sont proposés.
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="note">Note interne</label>
                                <textarea name="note" id="note" class="form-control" rows="3" placeholder="Note interne sur la distribution..."><t t-esc="note"/></textarea>
                            </div>
                        </div>

                        <div t-if="not member_rows" class="alert alert-warning" role="alert">
                            Aucun membre mobile actif n’est actuellement rattaché à ce compte société. Ajoutez d’abord un membre depuis la page Membres autorisés.
                        </div>
                        <div t-if="not carnet_rows" class="alert alert-warning" role="alert">
                            Aucun carnet distribuable n’est disponible dans le wallet société.
                        </div>

                        <div class="table-responsive" t-if="carnet_rows">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Type de carnet</th>
                                        <th class="text-end">Tickets disponibles</th>
                                        <th class="text-end">Carnets disponibles</th>
                                        <th class="text-end">Montant disponible</th>
                                        <th class="text-end">Carnets à distribuer</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="carnet_rows" t-as="row">
                                        <td>
                                            <div class="fw-semibold" t-esc="row['carnet_type'].display_name"/>
                                            <div class="text-muted small" t-esc="row['carnet_type'].code"/>
                                        </td>
                                        <td class="text-end" t-esc="row['qty_available']"/>
                                        <td class="text-end" t-esc="row['transferable_carnet_count']"/>
                                        <td class="text-end">
                                            <span t-esc="row['amount_available']"/>
                                            <span t-esc="row['carnet_type'].currency_id.name"/>
                                        </td>
                                        <td class="text-end" style="width: 180px;">
                                            <input type="number"
                                                   min="0"
                                                   step="1"
                                                   class="form-control text-end"
                                                   t-att-name="'qty_%s' % row['carnet_type'].id"
                                                   t-att-max="row['transferable_carnet_count']"
                                                   t-att-value="row['qty']"/>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr class="table-light fw-semibold">
                                        <td>Total</td>
                                        <td class="text-end" t-esc="distribution_totals['qty_available']"/>
                                        <td class="text-end" t-esc="distribution_totals['transferable_carnet_count']"/>
                                        <td class="text-end">
                                            <span t-esc="distribution_totals['amount_available']"/>
                                            <span t-esc="distribution_totals['currency_name']"/>
                                        </td>
                                        <td class="text-end" t-esc="distribution_totals['selected_carnet_qty']"/>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <div class="card-footer d-flex justify-content-end gap-2">
                        <a href="/my/fueltoken/distributions" class="btn btn-outline-secondary">Annuler</a>
                        <button type="submit" class="btn btn-primary" t-att-disabled="(not member_rows or not carnet_rows) and 'disabled' or None">
                            Distribuer
                        </button>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="portal_fueltoken_company_distributions" name="Tickets Carburant Société - Distributions">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2>Distributions société</h2>
                    <div class="d-flex gap-2">
                        <a href="/my/fueltoken/distributions/new" class="btn btn-primary">Nouvelle distribution</a>
                        <a href="/my/fueltoken" class="btn btn-outline-secondary">Retour Tickets Carburant</a>
                    </div>
                </div>
                <div class="table-responsive card">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Référence</th>
                                <th>État</th>
                                <th>Bénéficiaire</th>
                                <th>Date</th>
                                <th class="text-end">Tickets</th>
                                <th class="text-end">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="distributions" t-as="transfer">
                                <td><a t-att-href="'/my/fueltoken/distributions/%s' % transfer.id" t-esc="transfer.name"/></td>
                                <td><span t-field="transfer.state"/></td>
                                <td><span t-esc="transfer.dest_partner_id.display_name"/></td>
                                <td>
                                    <span t-if="transfer.confirmed_at" t-field="transfer.confirmed_at"/>
                                    <span t-else="" t-field="transfer.create_date"/>
                                </td>
                                <td class="text-end"><span t-esc="transfer.face_qty_total"/></td>
                                <td class="text-end"><span t-esc="transfer.amount_total"/> <span t-esc="transfer.currency_id.name"/></td>
                            </tr>
                            <tr t-if="not distributions">
                                <td colspan="6" class="text-muted text-center py-4">Aucune distribution société.</td>
                            </tr>
                        </tbody>
                        <tfoot t-if="distributions">
                            <tr class="table-light fw-semibold">
                                <td colspan="4">Total</td>
                                <td class="text-end" t-esc="distribution_totals['face_qty_total']"/>
                                <td class="text-end">
                                    <span t-esc="distribution_totals['amount_total']"/>
                                    <span t-esc="distribution_totals['currency_name']"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_fueltoken_company_distribution_detail" name="Tickets Carburant Société - Détail distribution">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="mb-1">Distribution <span t-esc="transfer.name"/></h2>
                        <div class="text-muted">Bénéficiaire : <span t-esc="transfer.dest_partner_id.display_name"/></div>
                    </div>
                    <a href="/my/fueltoken/distributions" class="btn btn-outline-secondary">Retour distributions</a>
                </div>
                <div class="card mb-4">
                    <div class="card-body row g-3">
                        <div class="col-md-4"><strong>État</strong><br/><span t-field="transfer.state"/></div>
                        <div class="col-md-4"><strong>Tickets</strong><br/><span t-esc="transfer.face_qty_total"/></div>
                        <div class="col-md-4"><strong>Montant</strong><br/><span t-esc="transfer.amount_total"/> <span t-esc="transfer.currency_id.name"/></div>
                    </div>
                </div>
                <div class="table-responsive card">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Type de carnet</th>
                                <th class="text-end">Carnets</th>
                                <th class="text-end">Tickets</th>
                                <th class="text-end">Montant</th>
                                <th>Expiration</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="transfer.line_ids" t-as="line">
                                <td><span t-esc="line.carnet_type_id.display_name"/></td>
                                <td class="text-end"><span t-esc="line.carnet_qty"/></td>
                                <td class="text-end"><span t-esc="line.qty_faces"/></td>
                                <td class="text-end"><span t-esc="line.amount_total"/> <span t-esc="line.currency_id.name"/></td>
                                <td>
                                    <span t-if="line.expires_at" t-field="line.expires_at"/>
                                    <span t-else="">—</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>
</odoo>

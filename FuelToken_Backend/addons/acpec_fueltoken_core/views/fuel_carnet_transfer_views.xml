<odoo>

    <!-- ─── LIST ───────────────────────────────────────────────────────────── -->
    <record id="view_fuel_carnet_transfer_list" model="ir.ui.view">
        <field name="name">acpec.fuel.carnet.transfer.list</field>
        <field name="model">acpec.fuel.carnet.transfer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="public_code"/>
                <field name="source_partner_id"/>
                <field name="dest_partner_id"/>
                <field name="state"/>
                <field name="face_qty_total"/>
                <field name="amount_total"/>
                <field name="confirmed_at"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ─── FORM ───────────────────────────────────────────────────────────── -->
    <record id="view_fuel_carnet_transfer_form" model="ir.ui.view">
        <field name="name">acpec.fuel.carnet.transfer.form</field>
        <field name="model">acpec.fuel.carnet.transfer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirmer"
                            invisible="state != 'draft'" class="btn-primary"
                            groups="acpec_fueltoken_base.group_fuel_manager,acpec_fueltoken_base.group_fuel_admin"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state != 'draft'"
                            groups="acpec_fueltoken_base.group_fuel_manager,acpec_fueltoken_base.group_fuel_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Parties">
                            <field name="source_wallet_id" readonly="state != 'draft'"/>
                            <field name="dest_wallet_id" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Totaux">
                            <field name="public_code" readonly="1"/>
                            <field name="face_qty_total" readonly="1"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="confirmed_at" readonly="1"/>
                            <field name="confirmed_by" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lignes de carnets">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="face_line_id"/>
                                    <field name="carnet_type_id" readonly="1"/>
                                    <field name="face_value" readonly="1"/>
                                    <field name="face_count" readonly="1"/>
                                    <field name="expires_at" readonly="1"/>
                                    <field name="carnet_qty"/>
                                    <field name="qty_faces" readonly="1"/>
                                    <field name="amount_total" readonly="1"/>
                                    <field name="dest_face_line_id" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Note">
                            <field name="note" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ─── ACTION ─────────────────────────────────────────────────────────── -->
    <record id="action_fuel_carnet_transfer" model="ir.actions.act_window">
        <field name="name">Transferts de carnets</field>
        <field name="res_model">acpec.fuel.carnet.transfer</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ─── MENU ────────────────────────────────────────────────────────────── -->
    <menuitem
        id="menu_fuel_carnet_transfer"
        name="Transferts de carnets"
        parent="acpec_fueltoken_base.menu_acpec_fueltoken_operations"
        action="action_fuel_carnet_transfer"
        sequence="20"/>

</odoo>

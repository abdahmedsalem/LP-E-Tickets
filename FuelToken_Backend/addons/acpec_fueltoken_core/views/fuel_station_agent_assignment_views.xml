<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fuel_station_form_agent_assignment" model="ir.ui.view">
        <field name="name">acpec.fuel.station.form.agent.assignment</field>
        <field name="model">acpec.fuel.station</field>
        <field name="inherit_id" ref="acpec_fueltoken_core.view_fuel_station_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <separator string="Agents autorisés"/>
                <field name="agent_ids" nolabel="1" colspan="2">
                    <list editable="bottom">
                        <field name="user_id"/>
                        <field name="active"/>
                        <field name="is_primary" readonly="1"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="note"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>

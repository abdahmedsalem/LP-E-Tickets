<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acpec_mobile_auth_otp_res_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.form.acpec.mobile.auth.otp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='user_default_rights']" position="before">
                <block title="SMS OTP" id="acpec_sms_otp_settings">
                    <setting string="Chinguisoft SMS" help="Configure the SMS gateway used for OTP validation.">
                        <group>
                            <field name="sms_provider"/>
                            <field name="sms_url"/>
                            <field name="sms_validation_key"/>
                            <field name="sms_token" password="True"/>
                            <field name="sms_default_lang"/>
                        </group>
                    </setting>
                    <setting string="OTP rate limits" help="Protect public OTP/SMS endpoints from abuse. Set a value to 0 to disable a limit.">
                        <group>
                            <field name="otp_limit_identifier_per_minute"/>
                            <field name="otp_limit_identifier_per_day"/>
                            <field name="otp_limit_ip_per_hour"/>
                            <field name="otp_limit_register_ip_per_day"/>
                        </group>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

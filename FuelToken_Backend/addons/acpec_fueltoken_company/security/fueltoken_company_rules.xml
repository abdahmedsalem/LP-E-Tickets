<odoo>
    <record id="rule_fuel_distributor_manager_company" model="ir.rule">
        <field name="name">Comptes Sociétés par société Odoo</field>
        <field name="model_id" ref="model_acpec_fuel_distributor"/>
        <field name="groups" eval="[(4, ref('acpec_fueltoken_base.group_fuel_manager')), (4, ref('acpec_fueltoken_base.group_fuel_admin'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
</odoo>

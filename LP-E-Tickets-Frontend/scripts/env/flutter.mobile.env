# Configuration locale  ./scripts/run.sh
# Origine Odoo seule : schéma + hôte + port, sans chemin /api/... ni slash final
# Pour un autre serveur : copiez flutter.mobile.example.env ou éditez l’URL ci-dessous.

ODOO_JSONRPC_BASE_URL=https://lpft.odoorim.com

ODOO_USE_ACPEC_AUTH=true
ODOO_FUEL_ENABLED=true
ODOO_DATABASE=ftlp2

# Optionnel
# ODOO_DATABASE=nom_bdd
API_BASE_URL=https://lpft.odoorim.com

# OTP_API_BASE_URL=https://lpft.odoorim.com

# Modèle / production — copiez vers flutter.mobile.env si vous changez de serveur
# (ou éditez directement scripts/env/flutter.mobile.env déjà présent dans le dépôt)

# Obligatoire — origine Odoo seule (http(s)://hôte:port), sans /api/... ni slash final
# Dev équipe (défaut dans flutter.mobile.env versionné) :
#   ODOO_JSONRPC_BASE_URL=http://57.128.181.183:8199
# Production / stores : utilisez HTTPS, ex. https://votre-odoo.example

ODOO_JSONRPC_BASE_URL=http://57.128.181.183:8199

ODOO_USE_ACPEC_AUTH=true
ODOO_FUEL_ENABLED=true

# Optionnel — OTP / inscription sur un service REST externe
# API_BASE_URL=

# ODOO_DEBUG_RPC=true
# ODOO_DATABASE=nom_bdd

<odoo>
    <record id="seq_acpec_fuel_purchase" model="ir.sequence">
        <field name="name">Tickets Carburant Achat</field>
        <field name="code">acpec.fuel.purchase</field>
        <field name="prefix">ACH/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_acpec_fuel_qr" model="ir.sequence">
        <field name="name">Tickets Carburant QR de retrait</field>
        <field name="code">acpec.fuel.qr</field>
        <field name="prefix">QR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_acpec_fuel_transaction" model="ir.sequence">
        <field name="name">Tickets Carburant Transaction</field>
        <field name="code">acpec.fuel.transaction</field>
        <field name="prefix">FTX/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_acpec_fuel_carnet" model="ir.sequence">
        <field name="name">Tickets Carburant Carnet</field>
        <field name="code">acpec.fuel.carnet</field>
        <field name="prefix">CNT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_acpec_fuel_carnet_transfer" model="ir.sequence">
        <field name="name">Tickets Carburant Transfert Carnets</field>
        <field name="code">acpec.fuel.carnet.transfer</field>
        <field name="prefix">TRF/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

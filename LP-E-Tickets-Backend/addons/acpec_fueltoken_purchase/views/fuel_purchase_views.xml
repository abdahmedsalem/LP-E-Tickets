<odoo>
    <record id="view_fuel_purchase_list" model="ir.ui.view">
        <field name="name">acpec.fuel.purchase.list</field>
        <field name="model">acpec.fuel.purchase</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="payment_method_name"/>
                <field name="payment_merchant_code"/>
                <field name="amount_total" width="130px" readonly="1"/>
                <field name="face_qty_total"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="approved_at"/>
            </list>
        </field>
    </record>
    <record id="view_fuel_purchase_form" model="ir.ui.view">
        <field name="name">acpec.fuel.purchase.form</field>
        <field name="model">acpec.fuel.purchase</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_submit" type="object" string="Soumettre" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_approve" type="object" string="Valider" invisible="state not in ('draft', 'submitted')" class="btn-primary" groups="acpec_fueltoken_base.group_fuel_admin" confirm="Valider ce lot d'achat ? Les lignes, le client, la référence paiement et les preuves resteront verrouillés. Continuer ?"/>
                    <button name="action_open_reject_wizard" type="object" string="Rejeter" invisible="state not in ('draft', 'submitted')" groups="acpec_fueltoken_base.group_fuel_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected" readonly="1"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_purchase_lines" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="purchase_line_count" widget="statinfo" string="Détail"/>
                        </button>
                    </div>

                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="payment_reference" readonly="1"/>
                            <field name="payment_method_name" readonly="1"/>
                            <field name="payment_merchant_code" readonly="1"/>
                        </group>
                        <group>
                            <field name="amount_total" readonly="1"/>
                            <field name="face_qty_total" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Preuves de paiement">
                            <field name="proof_attachment_ids" widget="many2many_binary" readonly="1"/>
                        </page>
                        <page string="Rejet">
                            <field name="rejection_reason" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_fuel_purchase" model="ir.actions.act_window">
        <field name="name">Lots d’achat</field>
        <field name="res_model">acpec.fuel.purchase</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_fuel_purchase" name="Lots d’achat" parent="acpec_fueltoken_base.menu_acpec_fueltoken_operations" action="action_fuel_purchase" sequence="10"/>

    <record id="view_fuel_purchase_reject_wizard_form" model="ir.ui.view">
        <field name="name">acpec.fuel.purchase.reject.wizard.form</field>
        <field name="model">acpec.fuel.purchase.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Motif de rejet">
                <group>
                    <field name="purchase_id" readonly="1"/>
                    <field name="rejection_reason" placeholder="Exemple : preuve de paiement illisible ou montant incorrect."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object" string="Confirmer le rejet" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_fuel_purchase_line_smart_list" model="ir.ui.view">
        <field name="name">acpec.fuel.purchase.line.smart.list</field>
        <field name="model">acpec.fuel.purchase.line</field>
        <field name="arch" type="xml">
            <list string="Détail du lot achat" create="0" edit="0" delete="0">
                <field name="carnet_type_id" width="260px"/>
                <field name="carnet_qty" width="90px" sum="Total carnets"/>
                <field name="face_count" width="100px"/>
                <field name="face_value" width="120px"/>
                <field name="generated_face_qty" width="110px" sum="Total tickets"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_total" width="130px" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total montant"/>
            </list>
        </field>
    </record>

</odoo>

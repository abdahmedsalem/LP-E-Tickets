<odoo>
    <record id="view_fuel_payment_method_list" model="ir.ui.view">
        <field name="name">acpec.fuel.payment.method.list</field>
        <field name="model">acpec.fuel.payment.method</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="merchant_code"/>
                <field name="color_hex"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_fuel_payment_method_form" model="ir.ui.view">
        <field name="name">acpec.fuel.payment.method.form</field>
        <field name="model">acpec.fuel.payment.method</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="merchant_code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="color_hex"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Instructions">
                        <field name="instructions" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fuel_payment_method" model="ir.actions.act_window">
        <field name="name">Moyens de paiement</field>
        <field name="res_model">acpec.fuel.payment.method</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem id="menu_fuel_payment_method"
              name="Moyens de paiement"
              parent="acpec_fueltoken_base.menu_acpec_fueltoken_config"
              action="action_fuel_payment_method"
              sequence="20"/>
</odoo>

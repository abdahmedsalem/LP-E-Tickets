<odoo>
    <record id="rule_fuel_carnet_type_user_company" model="ir.rule">
        <field name="name">Types de carnet client par société</field>
        <field name="model_id" ref="model_acpec_fuel_carnet_type"/>
        <field name="groups" eval="[(4, ref('acpec_fueltoken_base.group_fuel_user'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>

    <record id="rule_fuel_carnet_type_manager_company" model="ir.rule">
        <field name="name">Types de carnet gestionnaire par société</field>
        <field name="model_id" ref="model_acpec_fuel_carnet_type"/>
        <field name="groups" eval="[(4, ref('acpec_fueltoken_base.group_fuel_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>

    <record id="rule_fuel_carnet_type_admin_company" model="ir.rule">
        <field name="name">Types de carnet administrateur par société</field>
        <field name="model_id" ref="model_acpec_fuel_carnet_type"/>
        <field name="groups" eval="[(4, ref('acpec_fueltoken_base.group_fuel_admin'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
</odoo>

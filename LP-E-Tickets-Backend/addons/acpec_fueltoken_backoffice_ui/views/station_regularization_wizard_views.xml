<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_station_regularization_wizard_form" model="ir.ui.view">
        <field name="name">acpec.fuel.station.regularization.wizard.form</field>
        <field name="model">acpec.fuel.station.regularization.wizard</field>
        <field name="arch" type="xml">
            <form string="Régulariser les consommations station">
                <group>
                    <field name="reference"/>
                    <field name="transaction_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <footer>
                    <button name="action_regularize" string="Régulariser" type="object" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_station_regularization_wizard" model="ir.actions.act_window">
        <field name="name">Régulariser station</field>
        <field name="res_model">acpec.fuel.station.regularization.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="acpec_fueltoken_core.model_acpec_fuel_transaction"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>

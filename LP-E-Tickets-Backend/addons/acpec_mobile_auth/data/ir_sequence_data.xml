<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_acpec_mobile_auth_account_request" model="ir.sequence">
        <field name="name">ACPEC Mobile Auth Account Request</field>
        <field name="code">acpec.mobile.auth.account.request</field>
        <field name="prefix">MARQ/%(year)s/</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_acpec_mobile_session" model="ir.sequence">
        <field name="name">ACPEC Mobile Session</field>
        <field name="code">acpec.mobile.session</field>
        <field name="prefix">MSES/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_acpec_mobile_auth_otp" model="ir.sequence">
        <field name="name">ACPEC Mobile OTP</field>
        <field name="code">acpec.mobile.auth.otp</field>
        <field name="prefix">OTP/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_acpec_mobile_security_audit_log" model="ir.sequence">
        <field name="name">Journal audit sécurité mobile</field>
        <field name="code">acpec.mobile.security.audit.log</field>
        <field name="prefix">MSAUD/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>

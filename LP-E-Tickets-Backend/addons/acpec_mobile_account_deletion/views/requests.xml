<odoo>
  <record id="deletion_list" model="ir.ui.view">
    <field name="name">acpec.mobile.account.deletion.list</field>
    <field name="model">acpec.mobile.account.deletion</field>
    <field name="arch" type="xml"><list create="0" delete="0">
      <field name="reference"/><field name="user_id"/><field name="company_id"/>
      <field name="assigned_to"/><field name="create_date"/><field name="due_at"/><field name="state"/>
    </list></field>
  </record>
  <record id="deletion_form" model="ir.ui.view">
    <field name="name">acpec.mobile.account.deletion.form</field>
    <field name="model">acpec.mobile.account.deletion</field>
    <field name="arch" type="xml"><form create="0" delete="0">
      <header>
        <button name="action_start" type="object" string="1. Prendre en charge" invisible="state != 'pending'"/>
        <button name="action_prepare_deletion" type="object" string="2. Révoquer les accès"
          invisible="state != 'in_progress'"
          confirm="Cette action désactive le compte et révoque les accès. L'effacement des données reste à réaliser manuellement. Vérifiez d'abord le traitement des tickets et du solde."/>
        <button name="action_complete" type="object" string="Clôturer après suppression et confirmation"
          invisible="state != 'in_progress'" class="oe_highlight"
          confirm="J'atteste avoir effectué la suppression des données personnelles non soumises à conservation et adressé la confirmation au client. Ce bouton enregistre mon attestation ; il n'efface aucune donnée."/>
        <field name="state" widget="statusbar"/>
      </header>
      <sheet>
        <div class="alert alert-info" invisible="state == 'completed'">
          Traiter avant l'échéance annoncée : régler les tickets et le solde, révoquer les accès,
          supprimer les données personnelles non soumises à conservation, puis confirmer au client.
          Une désactivation ou un e-mail au support ne suffit pas.
        </div>
        <group><field name="reference"/><field name="user_id"/><field name="company_id"/>
          <field name="assigned_to"/><field name="create_date"/><field name="due_at"/>
        </group>
        <group string="1. Tickets et solde">
          <field name="settlement_notes" readonly="state == 'completed'"
            placeholder="Tickets et QR restants, solde, règlement effectué et référence ; indiquer explicitement s'il n'y en a aucun."/>
        </group>
        <group string="2. Suppression manuelle et conservation">
          <field name="erasure_evidence" readonly="state == 'completed'"
            placeholder="Données réellement supprimées, date, intervenant et référence du rapport de vérification. Ne pas recopier de données personnelles."/>
          <field name="retention_details" readonly="state == 'completed'"
            placeholder="Transactions, factures et justificatifs conservés : justification, durée ou date limite et accès autorisés. Indiquer s'il ne reste aucune donnée."/>
          <field name="processing_notes" readonly="state == 'completed'"/>
        </group>
        <group string="3. Confirmation finale au client">
          <field name="notification_channel" readonly="state == 'completed'"/>
          <field name="notification_sent_at" readonly="state == 'completed'"/>
          <field name="notification_reference" readonly="state == 'completed'"
            placeholder="Référence de la confirmation au client. Un e-mail en file ou au support seul n'est pas une confirmation finale."/>
        </group>
        <group string="Clôture"><field name="completed_at"/><field name="completed_by"/></group>
      </sheet>
    </form></field>
  </record>
  <record id="deletion_search" model="ir.ui.view">
    <field name="name">acpec.mobile.account.deletion.search</field>
    <field name="model">acpec.mobile.account.deletion</field>
    <field name="arch" type="xml"><search>
      <field name="reference"/><field name="user_id"/><field name="assigned_to"/>
      <filter name="open" string="À traiter" domain="[('state', '!=', 'completed')]"/>
      <filter name="mine" string="Mes demandes" domain="[('assigned_to', '=', uid)]"/>
      <filter name="overdue" string="En retard" domain="[('state', '!=', 'completed'), ('due_at', '&lt;', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
    </search></field>
  </record>
  <record id="deletion_action" model="ir.actions.act_window">
    <field name="name">Demandes de suppression</field>
    <field name="res_model">acpec.mobile.account.deletion</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_open': 1}</field>
  </record>
  <menuitem id="deletion_menu" name="Demandes de suppression" sequence="25"
    parent="acpec_mobile_auth.menu_mobile_auth_operations" action="deletion_action"
    groups="acpec_mobile_auth.group_mobile_auth_admin"/>
</odoo>
